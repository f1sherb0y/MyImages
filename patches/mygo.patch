+// awaitGPU reports whether the GPU that Prewarm readies on another thread
+// is not there yet, and has the window draw again once it is: until then
+// its frames draw in memory.
+func (h *windowHost) awaitGPU() bool {
+	pending := gpuPending()
+	if pending == nil {
+		return false
+	}
+	if !h.gpuAwaited {
+		h.gpuAwaited = true
+		go func() {
+			<-pending
+			if h.conn.Invalidate != nil {
+				h.invalidate()
+			}
+		}()
+	}
+	return true
+}
+
