--- /dev/null
+++ b/ui/prewarm_windows.go
@@ -0,0 +1,21 @@
+package ui
+
+import (
+	"os"
+
+	"github.com/egoist/mygo/internal/gpu/d3d11"
+)
+
+// Prewarm starts making what the first window's first frame needs of
+// the GPU, on another thread: call it as the program starts, before the
+// app runs, and the frame finds it made, or waits only for the rest.
+func Prewarm() {
+	if os.Getenv("MYGO_GPU") == "0" {
+		return
+	}
+	d3d11.Prewarm()
+}
+
+// gpuPending returns a channel that closes once the GPU that Prewarm
+// readies can draw, and nil when it can already.
+func gpuPending() <-chan struct{} { return d3d11.Prewarming() }
