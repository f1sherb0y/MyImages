diff --git a/internal/gpu/d3d11/shared.go b/internal/gpu/d3d11/shared.go
index e8080b1..e385259 100644
--- a/internal/gpu/d3d11/shared.go
+++ b/internal/gpu/d3d11/shared.go
@@ -279,3 +279,41 @@ func (r *Renderer) dropDevice() {
 	r.dev, r.classes = nil, nil
 	releaseDevice(d)
 }
+
+// prewarmed is the device Prewarm made, kept so that the renderers made
+// later share it, and prewarming closes once it is made, or could not be.
+var (
+	prewarmed  *sharedDevice
+	prewarming chan struct{}
+)
+
+// Prewarm makes the device renderers share on another thread, which
+// loads the GPU's driver: some 100 ms or more that the first window's
+// first frame would otherwise wait for on the main thread. Call it once,
+// before any window is made.
+func Prewarm() {
+	prewarming = make(chan struct{})
+	go func() {
+		defer close(prewarming)
+		if d, err := acquireDevice(); err == nil {
+			devices.Lock()
+			prewarmed = d
+			devices.Unlock()
+		}
+	}()
+}
+
+// Prewarming returns a channel that closes once the device Prewarm
+// makes is there, and nil when it is, or Prewarm was not called: a
+// window's first frame draws in memory rather than wait for it.
+func Prewarming() <-chan struct{} {
+	if prewarming == nil {
+		return nil
+	}
+	select {
+	case <-prewarming:
+		return nil
+	default:
+		return prewarming
+	}
+}
